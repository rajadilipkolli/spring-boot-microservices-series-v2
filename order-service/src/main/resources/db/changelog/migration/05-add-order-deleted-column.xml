<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <changeSet author="rajakolli" id="05-add-order-deleted-column">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="orders" columnName="deleted"/>
            </not>
        </preConditions>

        <addColumn tableName="orders">
            <column name="deleted" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <rollback>
            <dropColumn tableName="orders" columnName="deleted"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
