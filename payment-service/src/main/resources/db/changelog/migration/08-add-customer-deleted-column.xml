<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <changeSet author="rajakolli" id="08-add-customer-deleted-column">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="customers" columnName="deleted" schemaName="payment"/>
            </not>
        </preConditions>

        <addColumn tableName="customers" schemaName="payment">
            <column name="deleted" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <rollback>
            <dropColumn tableName="customers" columnName="deleted" schemaName="payment"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
