<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="03-create-processed-kafka-messages"
               author="yashdotdev13">

        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists
                        tableName="processed_kafka_messages"
                        schemaName="payment"/>
            </not>
        </preConditions>

        <createTable
                tableName="processed_kafka_messages"
                schemaName="payment">

            <column name="id" type="UUID">
                <constraints
                        primaryKey="true"
                        nullable="false"
                        primaryKeyName="processed_kafka_messages_pkey"/>
            </column>

            <column name="message_key" type="TEXT">
                <constraints nullable="false"/>
            </column>

            <column name="topic" type="TEXT">
                <constraints nullable="false"/>
            </column>

            <column name="consumer_group" type="TEXT">
                <constraints nullable="false"/>
            </column>

            <column name="processed_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>

        </createTable>

        <addUniqueConstraint
                tableName="processed_kafka_messages"
                schemaName="payment"
                columnNames="message_key, topic, consumer_group"
                constraintName="uk_processed_kafka_messages"/>

        <createIndex
                indexName="idx_processed_kafka_messages_processed_at"
                tableName="processed_kafka_messages"
                schemaName="payment">

            <column name="processed_at"/>

        </createIndex>

    </changeSet>

</databaseChangeLog>